                    "notes":"update nviTimeSet",
                    "type":"void",
                    "nickname":"putLONnviTimeSet",
                    "parameters":[
                        {
                            "name":"year",
                            "description":"year: 0..3000  0 means year not specified. 65535 represents null date",
                            "paramType":"path",
                            "required":true,
                            "type":"integer",
                            "defaultValue": 2015,
                            "allowMultiple":false
                        },
                        {
                            "name":"month",
                            "description":"month:  0..12    0 means month not specified",
                            "paramType":"path",
                            "required":true,
                            "type":"integer",
                            "defaultValue": 7,
                            "allowMultiple":false
                        },
                        {
                            "name":"day",
                            "description":"day: 0..31    0 means day not specified",
                            "paramType":"path",
                            "required":true,
                            "type":"integer",
                            "defaultValue": 15,
                            "allowMultiple":false
                        },
                        {
                            "name":"hour",
                            "description":"hour: 0..23",
                            "paramType":"path",
                            "required":true,
                            "type":"integer",
                            "defaultValue": 8,
                            "allowMultiple":false
                        },
                        {
                            "name":"min",
                            "description":"min: 0..59",
                            "paramType":"path",
                            "required":true,
                            "type":"integer",
                            "defaultValue": 0,
                            "allowMultiple":false
                        },
                        {
                            "name":"sec",
                            "description":"sec: 0..59",
                            "paramType":"path",
                            "required":true,
                            "type":"integer",
                            "allowMultiple":false
                        }
                    ],
                    "responseMessages":[
                        {
                            "code":400,
                            "message":"Invalid data supplied"
                        }
                    ]
                }
            ]
