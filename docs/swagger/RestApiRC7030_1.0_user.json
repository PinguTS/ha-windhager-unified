{
    "apiVersion":"1.0.0",
    "swaggerVersion":"1.2",
    "basePath": "/api/1.0",
    "resourcePath":"/user",
    "produces":["application/json"],
    "apis":[
        {
            "path":"/user/users",
            "operations":[
                {
                    "method":"GET",
                    "summary":"Retrieve all users",
                    "notes":"This can only be done by the logged in user.",
                    "type":"void",
                    "nickname":"getUsers",
                    "authorizations":{
                        "oauth2":[
                            {"scope":"test:anything","description":"anything"}
                        ]
                    },
                    "parameters":[
                    ]
                }
            ]
        },
        {
            "path":"/user/groups",
            "operations":[
                {
                    "method":"GET",
                    "summary":"Retrieve all groups",
                    "notes":"This can only be done by the logged in user.",
                    "type":"void",
                    "nickname":"getGroups",
                    "authorizations":{
                        "oauth2":[
                            {"scope":"test:anything","description":"anything"}
                        ]
                    },
                    "parameters":[
                    ]
                }
            ]
        },
        {
            "path":"/user/group/{groupname}",
            "operations":[
                {
                    "method":"GET",
                    "summary":"Retrieve group",
                    "notes":"This can only be done by the logged in user.",
                    "type":"void",
                    "nickname":"getGroup",
                    "authorizations":{
                        "oauth2":[
                            {"scope":"test:anything","description":"anything"}
                        ]
                    },
                    "parameters":[
                        {
                            "name":"groupname",
                            "description":"goup name to be retrieve",
                            "required":true,
                            "type":"string",
                            "paramType":"path",
                            "allowMultiple":false,
                            "enum":[
                                "OEM",
                                "SERVICE",
                                "ENDUSER"
                            ]
                        }
                    ]
                },
                {
                    "method":"POST",
                    "summary":"Add user to group",
                    "notes":"This can only be done by the logged in user.",
                    "type":"void",
                    "nickname":"addUserToGroup",
                    "authorizations":{
                        "oauth2":[
                            {"scope":"test:anything","description":"anything"}
                        ]
                    },
                    "parameters":[
                        {
                            "name":"groupname",
                            "description":"goup name to insert user",
                            "required":true,
                            "type":"string",
                            "paramType":"path",
                            "allowMultiple":false,
                            "enum":[
                                "OEM",
                                "SERVICE",
                                "ENDUSER"
                            ]
                        },
                        {
                            "name":"username",
                            "description":"username to insert into groupname",
                            "required":true,
                            "type":"string",
                            "paramType":"query",
                            "allowMultiple":false
                        }
                    ]
                },
                {
                    "method":"DELETE",
                    "summary":"Delete user from group",
                    "notes":"This can only be done by the logged in user.",
                    "type":"void",
                    "nickname":"deleteUserFromGroup",
                    "authorizations":{
                        "oauth2":[
                            {"scope":"test:anything","description":"anything"}
                        ]
                    },
                    "parameters":[
                        {
                            "name":"groupname",
                            "description":"goup name from where the user will be deleted.",
                            "required":true,
                            "type":"string",
                            "paramType":"path",
                            "allowMultiple":false,
                            "enum":[
                                "OEM",
                                "SERVICE",
                                "ENDUSER"
                            ]
                        },
                        {
                            "name":"username",
                            "description":"username to delete from groupname",
                            "required":true,
                            "type":"string",
                            "paramType":"query",
                            "allowMultiple":false
                        }
                    ]
                }
            ]
        },
        {
            "path":"/user",
            "operations":[
                {
                    "method":"POST",
                    "summary":"Create user",
                    "notes":"This can only be done by the logged in user.",
                    "type":"void",
                    "nickname":"createUser",
                    "authorizations":{
                        "oauth2":[
                            {"scope":"test:anything","description":"anything"}
                        ]
                    },
                    "parameters":[
                        {
                            "name":"body",
                            "description":"Created user object",
                            "required":true,
                            "type":"User",
                            "paramType":"body",
                            "allowMultiple":false
                        }
                    ]
                },
                {
                    "method":"PUT",
                    "summary":"Updated user",
                    "notes":"This can only be done by the logged in user.",
                    "type":"void",
                    "nickname":"updateUser",
                    "authorizations":{
                        "oauth2":[
                            {
                                "scope":"test:anything",
                                "description":"anything"
                            }
                        ]
                    },
                    "parameters":[
                        {
                            "name":"body",
                            "description":"user object to be updated (username and password are required)",
                            "required":true,
                            "type":"User",
                            "paramType":"body",
                            "allowMultiple":false
                        }
                    ],
                    "responseMessages":[
                        {
                            "code":400,
                            "message":"Invalid username supplied"
                        },
                        {
                            "code":404,
                            "message":"User not found"
                        }
                    ]
                }
            ]
        },
        {
            "path":"/user/{username}",
            "operations":[
                {
                    "method":"DELETE",
                    "summary":"Delete user",
                    "notes":"This can only be done by the logged in user.",
                    "type":"void",
                    "nickname":"deleteUser",
                    "authorizations":{
                        "oauth2":[
                            {
                                "scope":"test:anything",
                                "description":"anything"
                            }
                        ]
                    },
                    "parameters":[
                        {
                            "name":"username",
                            "description":"The username that needs to be deleted",
                            "required":true,
                            "type":"string",
                            "paramType":"path",
                            "allowMultiple":false
                        }
                    ],
                    "responseMessages":[
                        {
                            "code":400,
                            "message":"Invalid username supplied"
                        },
                        {
                            "code":404,
                            "message":"User not found"
                        }
                    ]
                },
                {
                    "method":"GET",
                    "summary":"Get user by user name",
                    "notes":"",
                    "type":"User",
                    "nickname":"getUserByName",
                    "authorizations":{
                    },
                    "parameters":[
                        {
                            "name":"username",
                            "description":"The name that needs to be fetched.",
                            "required":true,
                            "type":"string",
                            "paramType":"path",
                            "allowMultiple":false
                        }
                    ],
                    "responseMessages":[
                        {
                            "code":400,
                            "message":"Invalid username supplied"
                        },
                        {
                            "code":404,
                            "message":"User not found"
                        }
                    ]
                }
            ]
        },
        {
            "path":"/user/login",
            "operations":[
                {
                    "method":"GET",
                    "summary":"Logs user into the system",
                    "notes":"",
                    "type":"string",
                    "nickname":"loginUser",
                    "authorizations":{
                    },
                    "parameters":[
                        {
                            "name":"username",
                            "description":"The user name for login",
                            "required":true,
                            "type":"string",
                            "paramType":"query",
                            "allowMultiple":false
                        },
                        {
                            "name":"password",
                            "description":"The password for login in clear text",
                            "required":true,
                            "type":"string",
                            "paramType":"query",
                            "allowMultiple":false
                        }
                    ],
                    "responseMessages":[
                        {
                            "code":400,
                            "message":"Invalid username and password combination"
                        }
                    ]
                }
            ]
        },
        {
            "path":"/user/logout",
            "operations":[
                {
                    "method":"GET",
                    "summary":"Logs out current logged in user session",
                    "notes":"",
                    "type":"void",
                    "nickname":"logoutUser",
                    "authorizations":{
                    },
                    "parameters":[
                    ]
                }
            ]
        }
    ],
    "models":{
        "User":{
            "id":"User",
            "properties":{
                "id":{
                    "type":"integer",
                    "format":"int32"
                },
                "firstName":{
                    "type":"string"
                },
                "username":{
                    "type":"string"
                },
                "lastName":{
                    "type":"string"
                },
                "email":{
                    "type":"string"
                },
                "password":{
                    "type":"string"
                },
                "phone":{
                    "type":"string"
                },
                "userStatus":{
                    "type":"integer",
                    "format":"int32",
                    "description":"User Status",
                    "enum":[
                        "1-registered",
                        "2-active",
                        "3-closed"
                    ]
                }
            }
        }
    }
}
