    "models": {
        "Status": {
            "id": "Status",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "Error": {
            "id": "Error",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "message": {
                    "type": "string"
                },
                "fileds": {
                    "type": "string"
                }
            }
        },
        "NetworkConfig": {
            "id": "NetworkConfig",
            "required":[
                "DHCP", "IP", "SubnetMask", "Gateway", "DNS"
            ],
            "properties": {
                "MAC": {
                    "type": "string"
                },
                "DHCP": {
                    "type": "boolean",
                    "descripton": "Use DHCP"
                },
                "IP": {
                    "type": "string"
                },
                "SubnetMask": {
                    "type": "string"
                },
                "Gateway": {
                    "type": "string"
                },
                "DNS": {
                    "type": "string"
                },
                "WebPort": {
                    "type": "integer"
                }
            }
        },
        "DynIpConfig": {
            "id": "DynIpConfig",
            "required":[
                "active", "baseURL", "vpn"
            ],
            "properties": {
                "active": {
                    "type": "boolean",
                    "description": "enable DynIP service"
                },
                "vpn": {
                    "type": "boolean",
                    "description": "enable VPN service",
                    "default": false
                },
                "baseURL": {
                    "type": "string",
                    "description": "The base URL for the API"
                },
                "user": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                },
                "prop": {
                    "type": "string"
                }
            }
        },
        "AlarmConfig": {
            "id": "AlarmConfig",
            "required":[
                "active", "baseURL"
            ],
            "properties": {
                "active": {
                    "type": "boolean",
                    "description": "enable Alarm service"
                },
                "baseURL": {
                    "type": "string",
                    "description": "The base URL for the API"
                },
                "prop": {
                    "type": "string"
                }
            }
        }
    }
}
