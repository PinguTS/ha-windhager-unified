{
    "apiVersion": "1.0.1",
    "swaggerVersion": "1.2",
    "resourcePath": "/config",
    "basePath": "/api/1.0",
    "produces": [
                 "application/json"
                 ],
    "apis":[
        {
            "path": "/config/network",
            "operations":[
                {
                    "method":"GET",
                    "summary": "Network configuration",
                    "notes": "Retrieve NetworkConfig Object.",
                    "type": "NetworkConfig",
                    "nickname": "getNetworkConfig",
                    "parameters": [
                    ]
                },
                {
                    "method":"PUT",
                    "summary": "Update Network configuration",
                    "notes": "Update NetworkConfig Object.",
                    "type": "Status",
                    "nickname": "putNetworkConfig",
                    "parameters":[
                        {
                            "name": "networkConfig",
                            "description": "NetworkConfig JSON",
                            "type": "NetworkConfig",
                            "required": true,
                            "paramType":"body",
                            "allowMultiple":false
                        }
                    ],
                    "responseMessages":[
                        {
                            "code":200,
                            "message":"SUCCESS"
                        }
                    ]
                }
            ]
        },
        {
            "path": "/config/DynIP",
            "operations":[
                {
                    "method":"GET",
                    "summary": "DynIp configuration",
                    "notes": "Retrieve DynIpConfig Object.",
                    "type": "DynIpConfig",
                    "nickname": "getDynIpConfig",
                    "parameters": [
                    ]
                },
                {
                    "method":"PUT",
                    "summary": "Update DynIP configuration",
                    "notes": "Update DynIpConfig Object.",
                    "type": "Status",
                    "nickname": "putDynIpConfig",
                    "parameters":[
                        {
                            "name": "dynIpConfig",
                            "description": "DynIpConfig JSON",
                            "type": "DynIpConfig",
                            "required": true,
                            "paramType":"body",
                            "allowMultiple":false
                        }
                    ],
                    "responseMessages":[
                        {
                            "code":200,
                            "message":"SUCCESS"
                        }
                    ]
                }
            ]
        },
        {
            "path": "/config/Alarm",
            "operations":[
                {
                    "method":"GET",
                    "summary": "Alarm configuration",
                    "notes": "Retrieve AlarmConfig Object.",
                    "type": "AlarmConfig",
                    "nickname": "getAlarmConfig",
                    "parameters": [
                    ]
                },
                {
                    "method":"PUT",
                    "summary": "Update Alarm configuration",
                    "notes": "Update AlarmConfig configuration.",
                    "type": "Status",
                    "nickname": "putAlarmConfig",
                    "parameters":[
                        {
                            "name": "alarmConfig",
                            "description": "AlarmConfig JSON",
                            "type": "AlarmConfig",
                            "required": true,
                            "paramType":"body",
                            "allowMultiple":false
                        }
                    ],
                    "responseMessages":[
                        {
                            "code":200,
                            "message":"SUCCESS"
                        }
                    ]
                }
            ]
        }
