                    "type": "string"
                }
            }
        },
        "Subnet": {
            "id":"Subnet",
            "properties": {
                "id": {
                    "type": "integer",
                    "description": "id of the subnet"
                },
                "name": {
                    "type": "string",
                    "description": "name of the subnet"
                }
            }
        },
        "Node": {
            "id":"Node",
            "properties": {
                "nodeId": {
                    "type": "integer",
