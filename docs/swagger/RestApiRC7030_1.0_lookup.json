    ],
    "apis":[
        {
            "path": "/lookup",
            "operations":[
                {
                    "method":"GET",
                    "summary": "Subnet Collection",
                    "notes": "List all <b>subnets</b> in the plant.",
                    "type": "void",
                    "nickname": "getLookup",
                    "parameters": [
                    ]
                }
            ]
        },
        {
            "path": "/lookup/{subnetId}",
            "operations":[
                {
                    "method":"GET",
                    "summary": "Node Collection",
                    "notes": "List all <b>nodes</b> in the <b>subnet</b>.",
                    "type": "void",
                    "nickname": "getLookupNodes",
                    "parameters": [
                        {
                            "name": "subnetId",
                            "description": "Numeric `id` of the subnet to perform action with. (for RC7030 it is always 1).",
                            "paramType": "path",
                            "required": true,
                            "type": "integer",
                            "defaultValue": 1,
                            "allowMultiple": false
                        }
                    ]
                }
            ]
        },
        {
            "path": "/lookup/{subnetId}/{nodeId}",
            "operations":[
                {
                    "method":"GET",
                    "summary": "Retrieve a Node",
                    "notes": "A single <b>Node</b> object with all its details.",
                    "type": "void",
                    "nickname": "getLookupNode",
                    "parameters": [
                        {
                            "name": "subnetId",
                            "description": "Numeric `id` of the subnet to perform action with. (for RC7030 it is always 1).",
                            "paramType": "path",
                            "required": true,
                            "type": "integer",
                            "defaultValue": 1,
                            "allowMultiple": false
                        },
                        {
                            "name": "nodeId",
