                "name": {
                    "type": "string"
                },
                "fctType": {
                    "type": "integer"
                },
                "lock": {
                    "type": "bool"
                }
            }
        },
        "Level": {
            "id":"Level",
            "properties": {
                "id": {
                    "type": "integer",
