                },
                "subnet": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "functions": {
                    "type": "array",
                    "items": {
                        "$ref": "Function"
                    }
                },
                "neuronId": {
                    "type": "string"
                },
                "programId": {
                    "type": "string"
                }
            }
